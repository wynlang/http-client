// http-client - HTTP client for Wyn
// Wraps built-in Http.get/post with headers, JSON, auth.
//
// Usage:
//   var body = HttpClient.get("https://api.example.com/users")
//   var body = HttpClient.post("https://api.example.com/users", "{\"name\":\"Alice\"}")
//   HttpClient.set_header("Authorization", "Bearer token123")
//   HttpClient.set_header("Content-Type", "application/json")
//   var body = HttpClient.get("https://api.example.com/me")

// Set a header for subsequent requests
fn HttpClient_set_header(name: string, value: string) {
    Http.set_header(name, value)
}

// GET request
fn HttpClient_get(url: string) -> string {
    return http_get(url)
}

// POST request with body
fn HttpClient_post(url: string, body: string) -> string {
    return http_post(url, body)
}

// POST JSON - sets Content-Type automatically
fn HttpClient_post_json(url: string, json: string) -> string {
    Http.set_header("Content-Type", "application/json")
    return http_post(url, json)
}

// GET with Bearer token auth
fn HttpClient_get_auth(url: string, token: string) -> string {
    Http.set_header("Authorization", "Bearer " + token)
    return http_get(url)
}

// POST with Bearer token auth
fn HttpClient_post_auth(url: string, body: string, token: string) -> string {
    Http.set_header("Authorization", "Bearer " + token)
    Http.set_header("Content-Type", "application/json")
    return http_post(url, body)
}

// Clear all custom headers
fn HttpClient_clear_headers() {
    Http.clear_headers()
}
