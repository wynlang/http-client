test "url build" {
    // URL construction
    var base = "https://api.example.com"
    assert_eq(base + "/users", "https://api.example.com/users")
}

test "url with id" {
    // URL construction
    var base = "https://api.example.com"
    assert_eq(base + "/users/" + int_to_string(42), "https://api.example.com/users/42")
}

test "json body" {
    // URL construction
    var base = "https://api.example.com"
    // JSON body
    var json = "{\"name\": \"Alice\", \"age\": 30}"
    assert(json.contains("Alice"))
}

test "live GET httpbin" {
    // URL construction
    var base = "https://api.example.com"
    // JSON body
    var json = "{\"name\": \"Alice\", \"age\": 30}"
    // Live GET (if network available)
    var resp = Http.get("https://httpbin.org/get")
    if resp.len() > 10 {
    assert(resp.contains("origin"))
}
